# Windows Mobile Hotspot password. WPA2 requires 8-63 characters.
HOTSPOT_PASSWORD=

# Arduino UNO Q edge node (T-130/T-131). Leave UNOQ_HOST unset to use the in-process loopback mock.
# UNOQ_HOST=
# UNOQ_PORT=15052
# UNOQ_SERIAL_PORT=

# Solana compliance & alert chain (T-160). Unset = local placeholder audit log only.
# SOLANA_RPC_URL=
# SOLANA_KEYPAIR_PATH=

